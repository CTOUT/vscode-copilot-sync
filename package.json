{
  "scripts": {
    "spellcheck": "cspell \"**/*.md\" \"**/*.ps1\" \"**/*.sh\" \"**/*.yml\" \"**/*.json\"",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml}\"",
    "format": "prettier --write \"**/*.{md,json,yml,yaml}\""
  },
  "devDependencies": {
    "cspell": "^10.3.6",
    "prettier": "^3.9.10"
  }
}
